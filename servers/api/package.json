{
  "name": "@workspace/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "tsx --test features/auth/tests/*.test.ts features/health/tests/*.test.ts features/templates/*.test.ts features/upload/*.test.ts features/yjs/*.test.ts tests/environment.test.ts tests/http-boundaries.test.ts tests/mongodb.test.ts tests/shutdown.test.ts",
    "lint": "eslint \"**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/logging": "workspace:*",
    "@workspace/types": "workspace:*",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lib0": "^0.2.119",
    "mongoose": "^9.10.1",
    "multer": "^2.4.0",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^1.5.4",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.3",
    "@types/ws": "^8.18.2",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/tsconfig": "workspace:*",
    "eslint": "9.39.5",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
